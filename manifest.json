        "html-inline": "edit"
      }
    },
    "android": {
      "minAppVersion": "0.2.3",
      "required": [
        "sourceEditor",
        "runtimeStyles",
        "dialogs"
      ],
      "optional": [],
      "elements": {
        "html-block": "edit",
        "html-inline": "edit"
      }
    },
    "ios": {
      "minAppVersion": "0.2.3",
      "required": [
        "sourceEditor",
        "runtimeStyles",
        "dialogs"
      ],
      "optional": [],
      "elements": {
        "html-block": "edit",
        "html-inline": "edit"
      }
    }
  }
}
